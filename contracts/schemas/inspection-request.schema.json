{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinellm.local/v1/inspection-request.schema.json",
  "title": "inspection-request",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "segment.schema.json"
      },
      "maxItems": 40,
      "minItems": 1
    }
  },
  "required": [
    "operation_id",
    "segments"
  ],
  "additionalProperties": false
}
