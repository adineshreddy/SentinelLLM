{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinellm.local/v1/inspect-response.schema.json",
  "title": "inspect-response",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "decision.schema.json"
        },
        "replacement_segments": {
          "type": "array",
          "items": {
            "$ref": "segment.schema.json"
          },
          "maxItems": 40,
          "minItems": 0
        }
      },
      "required": [
        "decision"
      ],
      "additionalProperties": false
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "action": {
                "const": "redact"
              }
            },
            "required": [
              "action"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "replacement_segments"
        ]
      },
      "else": {
        "not": {
          "required": [
            "replacement_segments"
          ]
        }
      }
    }
  ]
}
