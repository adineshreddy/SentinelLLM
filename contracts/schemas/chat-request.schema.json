{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinellm.local/v1/chat-request.schema.json",
  "title": "chat-request",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "minItems": 1
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "default": 256
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 0.2
    },
    "stream": {
      "const": false,
      "default": false
    },
    "sentinel": {
      "type": "object",
      "properties": {
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              "text": {
                "type": "string",
                "minLength": 0,
                "maxLength": 16384
              }
            },
            "required": [
              "id",
              "source_id",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 8,
          "minItems": 0
        },
        "tool_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "output_schema_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "model",
    "messages"
  ],
  "additionalProperties": false
}
