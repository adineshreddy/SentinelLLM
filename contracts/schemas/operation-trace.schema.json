{
  "type": "object",
  "properties": {
    "operation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "application_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "kind": {
          "enum": [
            "chat",
            "preview",
            "tool"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "started",
            "in_flight",
            "completed",
            "blocked",
            "failed",
            "uncertain"
          ]
        },
        "stored_status": {
          "type": "string",
          "enum": [
            "started",
            "in_flight",
            "completed",
            "blocked",
            "failed",
            "uncertain"
          ]
        },
        "external_state": {
          "enum": [
            "none",
            "dispatching",
            "returned"
          ]
        },
        "external_kind": {
          "enum": [
            "none",
            "model",
            "tool"
          ]
        },
        "tool_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        }
      },
      "required": [
        "operation_id",
        "tenant_id",
        "application_id",
        "kind",
        "revision",
        "status",
        "stored_status",
        "external_state",
        "external_kind",
        "created_at",
        "updated_at",
        "deadline_at"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "audit-event.schema.json"
      }
    }
  },
  "required": [
    "operation",
    "events"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinellm.local/v1/operation-trace.schema.json",
  "title": "operation-trace"
}
