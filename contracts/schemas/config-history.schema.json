{
  "type": "object",
  "properties": {
    "versions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "policy": {
            "$ref": "policy.schema.json"
          },
          "registry": {
            "$ref": "registry.schema.json"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "actor_application": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "policy",
          "registry",
          "revision",
          "actor_application",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  },
  "required": [
    "versions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinellm.local/v1/config-history.schema.json",
  "title": "config-history"
}
