{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinellm.local/v1/segment.schema.json",
  "title": "segment",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "prompt",
        "rag",
        "response",
        "tool_arguments",
        "tool_result"
      ]
    },
    "path": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384
    }
  },
  "required": [
    "id",
    "stage",
    "path",
    "text"
  ],
  "additionalProperties": false
}
