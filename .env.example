# Generate private development credentials with: python3 tools/setup_dev.py
# Do not paste credentials into Git or the browser.
SENTINEL_APPLICATION_KEYS_JSON=
SENTINEL_INSPECTION_KEY=
SENTINEL_DEMO_KEY=
SENTINEL_PROVIDER=mock
SENTINEL_HOSTED_ENABLED=false
NAVIGATOR_BASE_URL=https://api.ai.it.ufl.edu/v1
NAVIGATOR_LLM_MODEL=gpt-oss-120b
NAVIGATOR_API_KEY=
SENTINEL_PORT=8080

# Private gateway-to-MCP adapter credential; generated by setup_dev.py.
SENTINEL_MCP_KEY=

# Phase 3 credentials are generated by setup_dev.py; never commit filled values.
SENTINEL_DB_OWNER_PASSWORD=
SENTINEL_DB_APP_PASSWORD=
SENTINEL_REDIS_PASSWORD=
SENTINEL_OPERATOR_KEY=
SENTINEL_VIEWER_KEY=
SENTINEL_OTHER_DEMO_KEY=
SENTINEL_OTHER_OPERATOR_KEY=

# Console passwords are separate from gateway API keys; generated by setup_dev.py.
SENTINEL_CONSOLE_PORT=3000
SENTINEL_CONSOLE_OPERATOR_PASSWORD=
SENTINEL_CONSOLE_VIEWER_PASSWORD=

# Opt-in local classifier. Rule-only mode remains the default.
SENTINEL_CLASSIFIER_MODE=off

# Phase 6: independent metrics, Grafana and isolated benchmark credentials.
# Generated by setup_dev.py. Monitoring is an optional Compose profile.
SENTINEL_METRICS_KEY=
SENTINEL_GRAFANA_PASSWORD=
SENTINEL_BENCH_KEY=
SENTINEL_BENCH_OPERATOR_KEY=
SENTINEL_HTTP_CAPACITY=32
