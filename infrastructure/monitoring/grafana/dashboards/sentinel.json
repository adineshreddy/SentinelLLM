{
  "uid": "sentinel-overview",
  "title": "SentinelLLM \u2014 Security and Reliability",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request outcomes / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,result) (rate(sentinel_http_duration_seconds_count[2m]))",
          "legendFormat": "{{route}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "0.5",
          "expr": "histogram_quantile(0.5, sum by (le,route) (rate(sentinel_http_duration_seconds_bucket[2m])))",
          "legendFormat": "{{route}} p50"
        },
        {
          "refId": "0.95",
          "expr": "histogram_quantile(0.95, sum by (le,route) (rate(sentinel_http_duration_seconds_bucket[2m])))",
          "legendFormat": "{{route}} p95"
        },
        {
          "refId": "0.99",
          "expr": "histogram_quantile(0.99, sum by (le,route) (rate(sentinel_http_duration_seconds_bucket[2m])))",
          "legendFormat": "{{route}} p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Dependency time (inspection / generation / tools / audit)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,dependency) (rate(sentinel_dependency_duration_seconds_bucket{result=\"success\"}[2m])))",
          "legendFormat": "{{dependency}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Security decisions / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action,stage) (rate(sentinel_decisions_total[2m]))",
          "legendFormat": "{{stage}} {{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Active admitted requests / limit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_http_active",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sentinel_http_capacity",
          "legendFormat": "capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "JVM heap / non-heap bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (area) (jvm_memory_used_bytes)",
          "legendFormat": "{{area}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Process CPU utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage",
          "legendFormat": "CPU fraction"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Dependency failures / 2 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency) (increase(sentinel_dependency_duration_seconds_count{result=\"failure\"}[2m]))",
          "legendFormat": "{{dependency}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Firing alerts (count)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "firing alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Scrape availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"sentinel-gateway\"}",
          "legendFormat": "gateway"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
